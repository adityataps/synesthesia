# Anthropic (required)
ANTHROPIC_API_KEY=

# GCP (required)
# Your GCP project ID — Firestore must be enabled in Native mode
GCP_PROJECT_ID=

# GCP Firestore database ID (optional — defaults to "(default)" if unset)
# Set this to use a named database instead of the project's default Firestore database.
GCP_FIRESTORE_DATABASE=

# GCP Firestore collection name (optional — defaults to "synesthesia-training")
GCP_FIRESTORE_COLLECTION=synesthesia-training

# GCP credentials (optional)
# Leave unset to use Application Default Credentials (gcloud auth application-default login).
# Set to a service account key JSON path if running outside a GCP environment.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
